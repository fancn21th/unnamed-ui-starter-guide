# AG-UI 对话接口地址（与 ag-ui-starter 保持一致）
# Mock 本地：http://localhost:7777 | 远程：http://10.3.70.145:31461 等
# Node 服务器：http://localhost:3001
VITE_AGUI_API=http://localhost:3001
# VITE_AGUI_API=http://localhost:7777
# VITE_AGUI_API = "http://10.3.70.145:31461"

# 是否使用真实对话 API（true=真实对接，false=Mock 数据）
VITE_USE_REAL_CHAT=true

# 是否使用 SSE 模式（使用我们的 AG-UI 转换器）
# true=SSE 模式 | false=使用上面的设置
VITE_USE_SSE=true
